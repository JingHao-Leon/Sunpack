<window title="SunPack Manager" width="1120" height="720" min-width="850" min-height="560" centered="true" frameless="false"/>
<script>
export default {
  data() { return {
    tab:'tasks',theme:'system',themeChoice:0,appearance:'light',pageOpacity:1,language:'en',texts:{},dispatch:false,requests:[],ready:false,busy:false,
    actionError:'',lastCommand:{},errors:{},logPath:'',cliAllowed:false,runtime:{known:false,running:false},
    tasks:{rows:[],total:0,page:0,pages:1,malformed:0},passwords:{rows:[],total:0,page:0,pages:1},fields:[],directories:[],
    startup:{enabled:false,command:''},directoryQuery:'',directoryLimit:50,
    taskQuery:'',taskRoot:'',taskStatus:0,selectedTask:'',
    statusNames:['','等待处理','等待文件释放','准备处理','正在处理','成功','失败','挂起：等待密码','挂起：等待分卷','等待重试','跳过','已合并'],
    rootEditor:false,rootOriginal:'',rootInput:'',rootOutput:'',rootDeep:false,
    configCategory:'',configQuery:'',configPage:0,drafts:{},savedField:'',settingError:{},
    passwordScope:'@global',passwordQuery:'',passwordOriginal:'',passwordValue:'',scopeText:'',passwordEditor:false,passwordDirect:false
  }; },
  computed: {
    errorList() { return Object.keys(this.errors).map(k=>k+': '+this.errors[k]); },
    shownDirectories() { let q=this.directoryQuery.toLowerCase(); return this.directories.filter(d=>(this.tab==='passwords'||d.watch)&&d.path.toLowerCase().indexOf(q)>=0).slice(0,this.directoryLimit); },
    directoryCount() { return this.directories.filter(d=>this.tab==='passwords'||d.watch).length; },
    chosenTask() { return this.tasks.rows.find(t=>t.id===this.selectedTask)||{id:'',path:'',statusText:'',details:'',outputs:[]}; },
    categories() { let seen={}; return this.fields.filter(f=>{ if(seen[f.category]) return false; seen[f.category]=true; return true; }).map(f=>({id:f.category,label:f.categoryLabel})); },
    configBlocks() {
      let groups=[],seen={};
      this.fields.forEach(f=>{
        let g=seen[f.block];
        if(!g) { g={id:f.block,key:f.block+'@'+this.language,label:f.blockLabel,module:f.module,category:f.category,fields:[],primary:false}; seen[f.block]=g; groups.push(g); }
        if(f.primary) { g.fields.unshift(f); g.primary=true; } else g.fields.push(f);
      });
      return groups;
    },
    matchingBlocks() { let q=this.configQuery.toLowerCase(); return this.configBlocks.filter(g=>(!this.configCategory||g.category===this.configCategory)&&(!q||(g.label+' '+g.module+' '+g.fields.map(f=>f.label+' '+f.description+' '+f.id).join(' ')).toLowerCase().indexOf(q)>=0)); },
    shownBlocks() { return this.matchingBlocks.slice(this.configPage*8,(this.configPage+1)*8); },
    configPages() { return Math.max(1,Math.ceil(this.matchingBlocks.length/8)); }
  },
  methods: {
    send(op,payload) {
      if(op==='cli') { if(this.busy) return; this.busy=true; this.actionError=''; }
      this.requests=this.requests.concat([{op:op,payload:payload||{}}]); this.dispatch=true;
    },
    go(tab) { this.send('navigate',{tab:tab}); },
    searchDirectory(value) { this.directoryQuery=value; this.directoryLimit=50; },
    searchConfig(value) { this.configQuery=value; this.configPage=0; },
    filterTasks(page) { this.send('filterTasks',{query:this.taskQuery,root:this.taskRoot,status:this.statusNames[this.taskStatus]||'',page:Math.max(0,page||0)}); },
    selectRoot(path) { this.taskRoot=path; this.selectedTask=''; this.filterTasks(0); },
    filterPasswords(page) { this.send('filterPasswords',{query:this.passwordQuery,scope:this.passwordScope,page:Math.max(0,page||0)}); },
    selectScope(path) { this.passwordScope=path; this.passwordEditor=false; this.filterPasswords(0); },
    editRoot(d) { this.actionError=''; this.rootOriginal=d?d.path:''; this.rootInput=d?d.path:''; this.rootOutput=d?d.output:''; this.rootDeep=d?d.deep:false; this.rootEditor=true; },
    rootAction(operation) { this.actionError=''; this.send('root',{operation:operation,original:this.rootOriginal,input:this.rootInput,output:this.rootOutput,deep:this.rootDeep}); },
    changeField(f,value) {
      let d=this.drafts[f.id]||{original:f.original,text:f.text,boolean:f.boolean,choice:f.choice};
      if(f.type==='boolean') d.boolean=value; else d.text=value;
      this.drafts=Object.assign({},this.drafts,{[f.id]:d}); this.settingError={}; this.savedField='';
    },
    saveField(f) {
      let d=this.drafts[f.id]; if(!d) return;
      let text=d.text;
      if(f.editor==='lines') text=JSON.stringify(text.split(/\r?\n/).filter(s=>s.length>0));
      this.send('saveConfig',{pointer:f.id,original:d.original,type:f.editor==='recursive'?'string':f.type,text:text,boolean:d.boolean,draft:Object.assign({},d)});
    },
    editPassword(p) { this.actionError=''; this.passwordOriginal=p?p.original:''; this.passwordValue=p?p.value:''; this.scopeText=p?p.scopes:(this.passwordScope[0]==='@'?'':this.passwordScope); this.passwordDirect=p?p.direct:false; this.passwordEditor=true; },
    passwordAction(operation) {
      this.actionError='';
      let scopes=this.scopeText.split(/\r?\n/).map(s=>s.trim()).filter(s=>s.length>0);
      if(operation==='save'&&this.passwordOriginal&&JSON.parse(this.passwordOriginal).scopes&&scopes.length===0) { this.actionError=this.texts.scopeGuard; return; }
      if(operation==='global') scopes=[];
      let values=this.passwordValue.split(/\r?\n/).filter(s=>s.length>0);
      if(!this.passwordOriginal&&operation==='save'&&values.length===0) { this.actionError=this.texts.batchEmpty; return; }
      this.send('password',{operation:operation==='save'||operation==='global'?(this.passwordOriginal?'replace':'addMany'):operation,
        original:this.passwordOriginal,value:this.passwordValue,values:values,scopes:scopes,scope:this.passwordScope[0]==='@'?'':this.passwordScope});
    }
  }
}
</script>
<style>
  .app { flex:1; gap:0px; color:var(--fg); font-size:14px; }
  .light { background:#f3f3f3; }
  .dark { background:#202020; }
  label { display:block; }
  .navigation { width:264px; padding:24px 12px 8px; gap:4px; }
  .identity { flex-direction:row; align-items:center; gap:12px; padding:0px 12px 24px; }
  .app-icon { width:40px; height:40px; padding:9px; border-radius:8px; color:var(--accent-text); }
  .brand { font-size:20px; font-weight:600; }
  .nav-item { display:flex; width:100%; flex-direction:row; align-items:center; height:40px; padding:0px 4px; gap:12px; border:0px; border-radius:4px; background:#00000001; color:var(--fg); }
  .light .nav-item:hover { background:#ebebeb; }
  .dark .nav-item:hover { background:#2d2d2d; }
  .light .on { background:#e6e6e6; color:var(--fg); }
  .dark .on { background:#363636; color:var(--fg); }
  .nav-icon { width:18px; height:18px; color:var(--fg); }
  .nav-mark { width:3px; height:16px; }
  .nav-indicator { width:3px; height:16px; border-radius:2px; background:var(--accent-text); }
  .light .nav-indicator { background:#0067c0; }
  .dark .nav-indicator { background:#60cdff; }
  .spacer { flex:1; }
  .body { flex:1; flex-direction:row; }
  .sidebar { flex:1; padding:20px 8px 0px; gap:8px; }
  .sidebar-heading { font-size:12px; color:var(--fg-2); padding:0px 4px 4px; }
  .sidebar button { min-height:32px; }
  .context-item { display:flex; width:100%; flex-direction:row; align-items:center; padding:7px 12px; gap:10px; border:0px; background:#00000001; color:var(--fg); }
  .context-item:hover { background:var(--sidebar-hover); }
  .content { flex:1; padding:24px 28px 24px; gap:16px; }
  .workspace { flex:1; gap:12px; }
  .page-header { flex-direction:row; align-items:center; gap:12px; padding-bottom:4px; }
  .row { flex-direction:row; align-items:center; gap:8px; }
  .column { gap:8px; }
  .fill { flex:1; }
  .heading { font-size:28px; font-weight:600; }
  .subheading { font-size:14px; font-weight:600; }
  .muted { color:var(--fg-2); font-size:12px; }
  .small { font-size:12px; }
  .directory { gap:6px; padding:8px 0px; }
  .directory button { font-size:12px; padding:5px 8px; }
  .directory .muted { white-space:nowrap; }
  .card { padding:16px 20px; gap:10px; border:1px solid var(--card-border); border-radius:8px; }
  .settings-row { flex-direction:row; align-items:center; gap:16px; }
  .setting-copy { flex:1; gap:4px; }
  .setting-title { font-size:14px; }
  .task { padding:16px; gap:8px; border:1px solid var(--card-border); border-radius:8px; }
  .taskname { display:flex; flex:1; flex-direction:row; align-items:center; background:#00000001; padding:0px; border:0px; color:var(--fg); }
  .status { color:var(--accent-text); font-size:12px; }
  .time { color:var(--fg-2); font-size:12px; }
  .error { color:#d15b48; font-size:12px; }
  .editor { flex:1; padding:20px; gap:12px; border:1px solid var(--card-border); border-radius:8px; }
  .editor > button { align-self:flex-start; }
  .light .card, .task.light, .light .editor, .card.light { background:#fbfbfb; border:1px solid #e5e5e5; }
  .dark .card, .task.dark, .dark .editor, .card.dark { background:#2b2b2b; border:1px solid #303030; }
  .pager { flex-direction:row; align-items:center; gap:12px; }
  .pager label { font-size:12px; color:var(--fg-2); }
  button { padding:6px 12px; border-radius:4px; min-height:32px; cursor:pointer; }
  input, select { height:32px; }
  .content > input, .sidebar > input, .editor input, .editor textarea { display:block; width:100%; }
  textarea { min-height:90px; }
  /* Core UI scrollbars overlay the viewport (up to 9 px plus a 2 px
     inset). Reserve 18 px for the bar and shadows in every scroll pane. */
  ScrollView { flex:1; padding:2px 18px 6px 2px; }
  .setting-control { width:220px; gap:8px; }
  .setting-control input, .setting-control textarea { width:100%; }
  .setting-control toggle { align-self:flex-end; }
  .setting-card { padding:16px 20px; gap:10px; border:1px solid var(--card-border); border-radius:8px; }
  .setting-card.light { background:#fbfbfb; border:1px solid #e5e5e5; }
  .setting-card.dark { background:#2b2b2b; border:1px solid #303030; }
  .setting-card { gap:0px; padding:0px 20px; }
  .block-fields { gap:0px; }
  .setting-item { padding:16px 0px; gap:10px; }
  .setting-item > textarea { width:100%; }
  .setting-divider { height:1px; background:var(--card-border); }
  .block-heading { padding:16px 0px 0px; font-size:14px; font-weight:600; }
  .runtime-badge { flex-direction:row; align-items:center; gap:7px; }
  .runtime-dot { width:8px; height:8px; border-radius:4px; background:#8a8a8a; }
  .runtime-dot.running { background:#6ccb5f; }
  .setting-description { color:var(--fg-2); font-size:12px; }
  .choice-host { height:32px; flex-direction:row; }
  .inline-message { color:var(--fg-2); font-size:12px; }
  .password-input { height:110px; }
  .nav-item { transition:background-color 140ms ease-out; }
</style>
<template>
  <div :class="'app '+appearance">
    <div class="body">
      <div class="navigation">
        <div class="identity">
          <svg class="app-icon" viewBox="0 0 24 24" fill="none"><path d="M3 7 12 3 21 7 12 11 3 7ZM3 7v10l9 4 9-4V7M12 11v10M7.5 5 16.5 9" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          <div class="column" style="gap:3px"><label class="brand">SunPack</label><label class="muted">{{ texts.manager }}</label></div>
        </div>
        <button id="tabTasks" :class="tab==='tasks'?'nav-item on':'nav-item'" @click="go('tasks')">
          <div class="nav-mark"><div :opacity="tab==='tasks'?1:0" transition="opacity 140ms ease-out" class="nav-indicator"/></div>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none"><path d="m3 6 1.5 1.5L7 5M10 6h11M3 12l1.5 1.5L7 11M10 12h11M3 18l1.5 1.5L7 17M10 18h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><label>{{ texts.tasks }}</label>
        </button>
        <button id="tabConfig" :class="tab==='config'?'nav-item on':'nav-item'" @click="go('config')">
          <div class="nav-mark"><div :opacity="tab==='config'?1:0" transition="opacity 140ms ease-out" class="nav-indicator"/></div>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 17h16M8 4v6M16 14v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><label>{{ texts.config }}</label>
        </button>
        <button id="tabPasswords" :class="tab==='passwords'?'nav-item on':'nav-item'" @click="go('passwords')">
          <div class="nav-mark"><div :opacity="tab==='passwords'?1:0" transition="opacity 140ms ease-out" class="nav-indicator"/></div>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none"><path d="M14 5a5 5 0 1 1-2 8l-7 7H2v-3l7-7a5 5 0 0 1 5-5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><label>{{ texts.passwords }}</label>
        </button>
      <div v-show="tab==='tasks'||tab==='passwords'" class="sidebar">
        <ScrollView><div class="column">
          <label class="sidebar-heading">{{ tab==='tasks'?texts.roots:texts.sources }}</label>
          <label class="muted">{{ texts.searchDirectory }}</label><input id="directorySearch" :value="directoryQuery" @input="searchDirectory"/>
          <button v-show="tab==='tasks'" :class="!taskRoot?'context-item on':'context-item'" @click="selectRoot('')"><label>{{ texts.allDirectories }}</label></button>
          <button v-show="tab==='tasks'" :class="taskRoot==='@other'?'context-item on':'context-item'" @click="selectRoot('@other')"><label>{{ texts.otherTasks }}</label></button>
          <button v-show="tab==='tasks'" id="newRoot" @click="editRoot(null)">{{ texts.addRoot }}</button>
          <button v-show="tab==='passwords'" :class="passwordScope==='@global'?'context-item on':'context-item'" @click="selectScope('@global')"><label>{{ texts.globalPasswords }}</label></button>
          <button v-show="tab==='passwords'" :class="passwordScope==='@history'?'context-item on':'context-item'" @click="selectScope('@history')"><label>{{ texts.history }}</label></button>
          <button v-show="tab==='passwords'" :class="passwordScope==='@all'?'context-item on':'context-item'" @click="selectScope('@all')"><label>{{ texts.manualPasswords }}</label></button>
          <div v-for="d in shownDirectories" :key="d.id" class="directory">
            <button :class="taskRoot===d.path||passwordScope===d.path?'context-item on':'context-item'" @click="tab==='tasks'?selectRoot(d.path):selectScope(d.path)"><label class="fill">{{ d.name||d.path }}</label></button>
            <label class="muted">{{ d.path }}</label>
            <div v-show="tab==='tasks'" class="row"><button @click="editRoot(d)">{{ texts.edit }}</button><button @click="send('openPath',{path:d.path})">{{ texts.open }}</button></div>
            <label v-show="tab==='tasks'" class="muted">{{ d.output?texts.output:texts.defaultOutput }}{{ d.effectiveOutput }}</label>
          </div>
          <button v-show="directoryLimit &lt; directoryCount" @click="directoryLimit=directoryLimit+50">{{ texts.moreDirectories }}</button>
          <label class="muted">{{ tab==='tasks'?texts.watchHint:texts.scopeHint }}</label>
        </div></ScrollView>
      </div>
      <div v-show="tab==='config'" class="sidebar">
        <label class="sidebar-heading">{{ texts.categories }}</label>
        <button :class="!configCategory?'context-item on':'context-item'" @click="configCategory='',configPage=0"><label>{{ texts.allSettings }}</label></button>
        <ScrollView id="categoryScroll"><div class="column"><button v-for="c in categories" :key="c.id" :id="'category-'+c.id" :class="configCategory===c.id?'context-item on':'context-item'" @click="configCategory=c.id,configPage=0"><label>{{ c.label }}</label></button></div></ScrollView>
      </div>
      </div>
      <div class="workspace">
      <div id="page-tasks" v-show="tab==='tasks'" class="content" :opacity="pageOpacity" transition="opacity 180ms ease-out">
        <div class="page-header"><label class="heading">{{ texts.tasks }}</label><div class="spacer"/><div id="runtimeStatus" class="runtime-badge"><div :class="runtime.known &amp;&amp; runtime.running?'runtime-dot running':'runtime-dot'"/><label class="muted">{{ !runtime.known?texts.runtimeUnknown:runtime.running?texts.runtimeRunning:texts.runtimeStopped }}</label></div></div>
        <div class="row"><button id="watchStart" :enabled="cliAllowed" @click="send('cli',{action:'start'})">{{ texts.startWatch }}</button><button id="watchStop" :enabled="cliAllowed" @click="send('cli',{action:'stop'})">{{ texts.stopWatch }}</button></div>
        <label v-show="actionError" class="error">{{ actionError }}</label>
        <label class="muted">{{ texts.taskSearch }}</label><div class="row"><input id="taskSearch" class="fill" v-model="taskQuery" @submit="filterTasks(0)"/>
          <div id="taskStatusHost" style="width:180px;height:32px"/>
          <button id="filterTasks" @click="filterTasks(0)">{{ texts.filter }}</button></div>
        <div v-show="rootEditor" class="card">
          <div class="row"><label class="subheading">{{ rootOriginal?texts.editRoot:texts.addRoot }}</label><div class="spacer"/><button @click="rootEditor=false">{{ texts.collapse }}</button></div>
          <label class="muted">{{ texts.inputDirectory }}</label><div class="row"><input class="fill" v-model="rootInput"/><button @click="send('browse',{target:'rootInput'})">{{ texts.chooseDirectory }}</button></div>
          <label class="muted">{{ texts.rootOutput }}</label><div class="row"><input class="fill" v-model="rootOutput"/><button @click="send('browse',{target:'rootOutput'})">{{ texts.chooseOutput }}</button></div>
          <div class="row"><toggle v-model="rootDeep"/><label>{{ texts.deep }}</label><div class="spacer"/><button id="saveRoot" type="primary" @click="rootAction('save')">{{ texts.saveRoot }}</button><button v-show="rootOriginal" @click="rootAction('delete')">{{ texts.deleteRoot }}</button></div>
        </div>
        <ScrollView id="taskListScroll"><div class="column">
          <label v-show="tasks.total===0" class="muted">{{ texts.noTasks }}</label>
          <div v-for="t in tasks.rows" :key="t.id" :class="'task '+appearance" @click="selectedTask=t.id">
            <div class="row"><button class="taskname" @click="selectedTask=t.id"><label class="fill subheading">{{ t.name }}</label></button><label class="status">{{ t.statusText }}</label></div>
            <label class="muted">{{ t.path }}</label><div class="row"><label class="small fill">{{ t.summary }}</label><label class="time">{{ t.time }}</label></div>
          </div>
        </div></ScrollView>
        <div class="pager"><button :enabled="tasks.page>0" @click="filterTasks(tasks.page-1)">{{ texts.previous }}</button><label>{{ tasks.page+1 }} / {{ tasks.pages }} · {{ tasks.total }} {{ texts.taskCount }}</label><button :enabled="tasks.page+1 &lt; tasks.pages" @click="filterTasks(tasks.page+1)">{{ texts.next }}</button></div>
        <div v-show="chosenTask.id" class="card"><div class="row"><label class="subheading">{{ texts.details }} · {{ chosenTask.statusText }}</label><div class="spacer"/><button @click="send('openPath',{path:chosenTask.path})">{{ texts.locate }}</button><button @click="selectedTask=''">{{ texts.collapse }}</button></div>
          <div class="row"><button v-for="output in chosenTask.outputs" :key="output" @click="send('openPath',{path:output})">{{ texts.openOutput }}</button></div><textarea id="taskDetails" :value="chosenTask.details" style="height:130px"/></div>
        <label v-show="tasks.malformed" class="error">{{ tasks.malformed }} {{ texts.invalidLogs }}</label>
      </div>
      <div id="page-config" v-show="tab==='config'" class="content" :opacity="pageOpacity" transition="opacity 180ms ease-out">
        <div class="page-header"><label class="heading">{{ texts.config }}</label><div class="spacer"/><button id="watchReload" :enabled="cliAllowed" @click="send('cli',{action:'reload'})">{{ texts.reload }}</button></div>
        <label v-show="actionError" class="error">{{ actionError }}</label>
        <label class="muted">{{ texts.settingSearch }}</label><input id="configSearch" :value="configQuery" @input="searchConfig"/>
        <ScrollView id="configListScroll"><div class="column">
          <div v-show="!configCategory &amp;&amp; !configQuery &amp;&amp; configPage===0" class="card settings-row">
            <div class="setting-copy"><label class="setting-title">{{ texts.startup }}</label><label class="muted">{{ texts.startupDescription }}</label></div>
            <button id="startupToggle" :enabled="cliAllowed" @click="send('cli',{action:startup.enabled?'startupDisable':'startupEnable'})">{{ startup.enabled?texts.startupOff:texts.startupOn }}</button>
          </div>
          <div v-show="!configCategory &amp;&amp; !configQuery &amp;&amp; configPage===0" class="card settings-row"><div class="setting-copy"><label class="setting-title">{{ texts.theme }}</label><label class="muted">{{ texts.themeDescription }}</label></div><div id="themeHost" style="width:180px;height:32px"/></div>
          <div v-for="g in shownBlocks" :key="g.key" :id="'block-'+g.id" :class="'setting-card '+appearance">
            <label v-show="(g.fields.length>1||g.module) &amp;&amp; !g.primary" class="block-heading">{{ g.label }}</label>
            <!-- This Core UI version binds inner loops through a conditional
                 scope. Groups are always nonempty; visibility uses v-show. -->
            <div v-if="true" class="block-fields">
            <div v-for="f in g.fields" :key="f.key" :id="'field-'+f.id" class="setting-item">
            <div v-show="f.id!==g.fields[0].id" class="setting-divider"/>
            <div class="settings-row">
              <div class="setting-copy"><label :class="f.primary?'subheading':'setting-title'">{{ f.label }}</label><label v-show="f.description" class="setting-description">{{ f.description }}</label></div>
              <div class="setting-control">
                <toggle v-show="f.editor==='toggle'" :id="'toggle-'+f.id" :value="drafts[f.id]?drafts[f.id].boolean:f.boolean" @change="v=>changeField(f,v)"/>
                <div v-show="f.editor==='choice'||f.editor==='recursive'" :id="'choice-'+f.id" class="choice-host"/>
                <input v-show="f.editor==='text'" :id="'input-'+f.id" :value="drafts[f.id]?drafts[f.id].text:f.text" @input="v=>changeField(f,v)"/>
                <div v-show="f.editor==='recursive' &amp;&amp; (drafts[f.id]?drafts[f.id].choice:f.choice)===2" class="column"><label class="muted">{{ texts.rounds }}</label><input :id="'rounds-'+f.id" :value="drafts[f.id]?drafts[f.id].text:f.text" @input="v=>changeField(f,v)"/></div>
                <label v-show="f.editor==='readonly'" class="muted">{{ texts.readOnly }}</label>
              </div>
            </div>
            <textarea v-show="f.editor==='lines'" :id="'lines-'+f.id" :value="drafts[f.id]?drafts[f.id].text:f.text" @input="v=>changeField(f,v)" style="height:110px"/>
            <div v-show="drafts[f.id]||savedField===f.id||settingError.id===f.id" class="row"><label v-show="settingError.id===f.id" class="error fill">{{ settingError.message }}</label><label v-show="savedField===f.id &amp;&amp; !drafts[f.id]" class="inline-message">{{ texts.saved }}</label><div class="spacer"/><button v-show="drafts[f.id]" :id="'save-'+f.id" type="primary" @click="saveField(f)">{{ texts.save }}</button></div>
            </div>
            </div>
          </div>
          <label v-show="matchingBlocks.length===0" class="muted">{{ texts.noSettings }}</label>
        </div></ScrollView>
        <div v-show="configPages>1" class="pager"><button :enabled="configPage>0" @click="configPage=configPage-1">{{ texts.previous }}</button><label>{{ configPage+1 }} / {{ configPages }}</label><button :enabled="configPage+1 &lt; configPages" @click="configPage=configPage+1">{{ texts.next }}</button></div>
      </div>
      <div id="page-passwords" v-show="tab==='passwords'" class="content" :opacity="pageOpacity" transition="opacity 180ms ease-out">
        <div class="page-header"><label class="heading">{{ texts.passwords }}</label><div class="spacer"/><button v-show="!passwordEditor" id="newPassword" type="primary" @click="editPassword(null)">{{ texts.addPasswords }}</button></div>
        <label v-show="actionError" class="error">{{ actionError }}</label>
        <label v-show="!passwordEditor" class="muted">{{ passwordScope==='@global'?texts.globalPasswords:passwordScope==='@history'?texts.history:passwordScope==='@all'?texts.manualPasswords:passwordScope }}</label>
        <label v-show="!passwordEditor" class="muted">{{ texts.passwordSearch }}</label><div v-show="!passwordEditor" class="row"><input id="passwordSearch" class="fill" v-model="passwordQuery" @submit="filterPasswords(0)"/><button @click="filterPasswords(0)">{{ texts.filter }}</button></div>
        <div class="body">
          <ScrollView v-show="!passwordEditor"><div class="column"><label v-show="passwords.total===0" class="muted">{{ texts.noPasswords }}</label>
            <div v-for="p in passwords.rows" :key="p.id" :class="'card '+appearance"><label>{{ p.value }}</label><label class="muted">{{ p.source }}</label><label v-show="p.scopes" class="muted">{{ p.scopes }}</label><button v-show="passwordScope==='@all'||passwordScope==='@global'||p.direct" @click="editPassword(p)">{{ texts.editPassword }}</button><button v-show="passwordScope==='@history'" @click="editPassword(p)">{{ texts.copyPassword }}</button></div>
          </div></ScrollView>
          <div v-show="passwordEditor" class="editor">
            <div class="row"><label class="subheading">{{ passwordOriginal?texts.editPassword:texts.addPasswords }}</label><div class="spacer"/><button @click="passwordEditor=false">{{ texts.collapse }}</button></div>
            <ScrollView><div class="column">
              <label class="muted">{{ passwordOriginal?texts.passwordText:texts.batchHint }}</label><textarea id="passwordValue" v-model="passwordValue" class="password-input"/>
              <label class="subheading">{{ texts.scopeLabel }}</label><label class="muted">{{ texts.scopeDescription }}</label><textarea id="passwordScopes" v-model="scopeText" style="height:100px"/>
              <button @click="send('browse',{target:'scopeText'})">{{ texts.chooseScope }}</button><button v-show="passwordOriginal &amp;&amp; passwordDirect" @click="passwordAction('removeScope')">{{ texts.removeScope }}</button><button v-show="passwordOriginal &amp;&amp; scopeText" @click="passwordAction('global')">{{ texts.makeGlobal }}</button><button v-show="passwordOriginal" @click="passwordAction('delete')">{{ texts.deletePassword }}</button>
            </div></ScrollView><button id="savePassword" type="primary" @click="passwordAction('save')">{{ texts.savePasswords }}</button>
          </div>
        </div>
        <div v-show="!passwordEditor" class="pager"><button :enabled="passwords.page>0" @click="filterPasswords(passwords.page-1)">{{ texts.previous }}</button><label>{{ passwords.page+1 }} / {{ passwords.pages }} · {{ passwords.total }} {{ texts.entries }}</label><button :enabled="passwords.page+1 &lt; passwords.pages" @click="filterPasswords(passwords.page+1)">{{ texts.next }}</button></div>
      </div>
      </div>
    </div>
    <div v-show="errorList.length" class="card"><label class="error">{{ texts.fileProblems }}</label><label v-for="e in errorList" :key="e" class="error">{{ e }}</label></div>
    <div v-if="dispatch" id="dispatch" :visible="false" style="position:absolute;left:0px;top:0px;width:0px;height:0px"/>
  </div>
</template>
