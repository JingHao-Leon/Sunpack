<window title="SunPack Manager" width="1120" height="720" min-width="850" min-height="560" centered="true" frameless="false"/>
<script>
export default {
  data() { return {
    tab:'tasks',theme:'system',themeChoice:0,appearance:'light',language:'en',texts:{},dispatch:false,requests:[],ready:false,busy:false,
    actionError:'',lastCommand:{},errors:{},logPath:'',cliAllowed:false,runtime:{known:false,running:false},
    tasks:{rows:[],total:0,page:0,pages:1,malformed:0},passwords:{rows:[],total:0,page:0,pages:1},fields:[],directories:[],
    startup:{enabled:false,command:''},directoryQuery:'',directoryLimit:50,
    taskQuery:'',taskRoot:'',taskStatus:0,
    statusNames:['','等待处理','等待文件释放','准备处理','正在处理','成功','失败','挂起：等待密码','挂起：等待分卷','等待重试','跳过','已合并'],
    rootEditor:false,rootOriginal:'',rootInput:'',rootOutput:'',rootDeep:false,
    configCategory:'',configQuery:'',configPage:0,drafts:{},toggleDrafts:{},saving:false,staging:false,saveError:'',saveGeneration:0,passwordEdits:[],rootEdits:[],rootBaseline:'',rootExpected:null,passwordBaseline:'',
    passwordScope:'@all',passwordQuery:'',passwordOriginal:'',passwordValue:'',scopeText:'',passwordEditor:false
  }; },
  computed: {
    rootDirty() { return this.rootEditor&&JSON.stringify({input:this.rootInput,output:this.rootOutput,deep:this.rootDeep})!==this.rootBaseline; },
    passwordDirty() { return this.passwordEditor&&(this.passwordOriginal?JSON.stringify({value:this.passwordValue,scopes:this.scopeText})!==this.passwordBaseline:this.passwordValue.length>0); },
    changeCount() { return Object.keys(this.drafts).length+Object.keys(this.toggleDrafts).length+this.passwordEdits.length+this.rootEdits.length+(this.rootDirty?1:0)+(this.passwordDirty?1:0); },
    errorList() { return Object.keys(this.errors).map(k=>k+': '+this.errors[k]); },
    shownDirectories() { let q=this.directoryQuery.toLowerCase(); return this.directories.filter(d=>d.watch&&d.path.toLowerCase().indexOf(q)>=0).slice(0,this.directoryLimit); },
    directoryCount() { return this.directories.filter(d=>d.watch).length; },
    chosenDirectory() { return this.directories.find(d=>d.watch&&d.path===this.taskRoot)||{path:'',effectiveOutput:''}; },
    categories() { let seen={}; return this.fields.filter(f=>{ if(seen[f.category]) return false; seen[f.category]=true; return true; }).map(f=>({id:f.category,label:f.categoryLabel})); },
    configBlocks() {
      let groups=[],seen={};
      this.fields.forEach(f=>{
        let g=seen[f.block];
        if(!g) { g={id:f.block,key:f.block+'@'+this.language,label:f.blockLabel,module:f.module,category:f.category,fields:[],primary:false}; seen[f.block]=g; groups.push(g); }
        if(f.primary) { g.fields.unshift(f); g.primary=true; } else g.fields.push(f);
      });
      return groups;
    },
    matchingBlocks() { let q=this.configQuery.toLowerCase(); return this.configBlocks.filter(g=>(!this.configCategory||g.category===this.configCategory)&&(!q||(g.label+' '+g.module+' '+g.fields.map(f=>f.label+' '+f.description+' '+f.id).join(' ')).toLowerCase().indexOf(q)>=0)); },
    shownBlocks() { return this.matchingBlocks.slice(this.configPage*8,(this.configPage+1)*8); },
    configPages() { return Math.max(1,Math.ceil(this.matchingBlocks.length/8)); }
  },
  methods: {
    send(op,payload) {
      if(op==='cli') { if(this.busy) return; this.busy=true; this.actionError=''; }
      let requests=op==='filterTasks'||op==='filterPasswords'?this.requests.filter(r=>r.op!==op):this.requests;
      this.requests=requests.concat([{op:op,payload:payload||{}}]); this.dispatch=true;
    },
    go(tab) { this.send('navigate',{tab:tab}); },
    selectCategory(category) { if(this.configCategory===category) return; this.configCategory=category; this.configPage=0; this.send('animateView',{id:'configBlocks'}); },
    searchDirectory(value) { this.directoryQuery=value; this.directoryLimit=50; },
    searchConfig(value) { this.configQuery=value; this.configPage=0; },
    searchTasks(value) { this.taskQuery=value; this.filterTasks(0); },
    searchPasswords(value) { this.passwordQuery=value; this.filterPasswords(0); },
    filterTasks(page) { this.send('filterTasks',{query:this.taskQuery,root:this.taskRoot,status:this.statusNames[this.taskStatus]||'',page:Math.max(0,page||0)}); },
    selectRoot(path) { if(this.rootDirty) { this.rootAction('save',{taskRoot:path,rootEditor:false}); return; } this.taskRoot=path; this.filterTasks(0); },
    filterPasswords(page) { this.send('filterPasswords',{query:this.passwordQuery,scope:this.passwordScope,page:Math.max(0,page||0)}); },
    selectScope(path) { if(this.passwordDirty) { this.passwordAction('save',{passwordScope:path,passwordEditor:false}); return; } this.passwordScope=path; this.passwordEditor=false; this.filterPasswords(0); },
    rootState(d) { let input=d?d.path:'',output=d?d.output:'',deep=d?d.deep:false; return {rootOriginal:input,rootInput:input,rootOutput:output,rootDeep:deep,rootExpected:d?{output:output,deep:deep}:null,rootBaseline:JSON.stringify({input:input,output:output,deep:deep}),rootEditor:true}; },
    editRoot(d) { if(this.saving||this.staging) return; let next=this.rootState(d); if(this.rootDirty) { this.rootAction('save',next); return; } Object.assign(this,next); this.send('revealForm',{kind:'root'}); },
    rootEdit(operation) {
      let edit={operation:operation,original:this.rootOriginal,input:this.rootInput,output:this.rootOutput,deep:this.rootDeep,expected:this.rootExpected};
      if(operation==='save'&&!this.rootOriginal) { edit.operation='addMany'; edit.inputs=this.rootInput.split(/\r?\n/).map(s=>s.trim()).filter(s=>s.length>0); if(!edit.inputs.length) throw new Error(this.texts.rootsEmpty); }
      return edit;
    },
    rootAction(operation,nextState) {
      if(this.saving||this.staging) return;
      if(operation==='save'&&!this.rootDirty) { Object.assign(this,nextState||{rootEditor:false}); return; }
      try { let edit=Object.assign(this.rootEdit(operation),{nextState:nextState||{rootEditor:false}}); this.staging=true; this.saveError=''; this.send('stageRoot',edit); }
      catch(e) { this.saveError=e.message; }
    },
    changeField(f,value) {
      let d=this.drafts[f.id]||{original:f.original,text:f.text,boolean:f.boolean,choice:f.choice,baselineText:f.text,baselineBoolean:f.boolean};
      d.text=value;
      let next=Object.assign({},this.drafts);
      if(d.text===d.baselineText) delete next[f.id]; else next[f.id]=d;
      this.drafts=next; this.saveError='';
    },
    passwordState(p) { let original=p?p.original:'',value=p?p.value:'',scopes=p?p.scopes:''; return {passwordOriginal:original,passwordValue:value,scopeText:scopes,passwordBaseline:JSON.stringify({value:value,scopes:scopes}),passwordEditor:true}; },
    editPassword(p) { if(this.saving||this.staging) return; let next=this.passwordState(p); if(!next.passwordOriginal) next.passwordScope='@all'; if(this.passwordDirty) { this.passwordAction('save',next); return; } let changed=next.passwordScope && this.passwordScope!==next.passwordScope; Object.assign(this,next); if(changed) this.filterPasswords(0); this.send('revealForm',{kind:'password'}); },
    passwordEdit(operation) {
      let scopes=this.scopeText.split(/\r?\n/).map(s=>s.trim()).filter(s=>s.length>0);
      if(operation==='save'&&this.passwordOriginal&&JSON.parse(this.passwordOriginal).scopes&&scopes.length===0) throw new Error(this.texts.scopeGuard);
      if(operation==='global') scopes=[];
      let values=this.passwordValue.split(/\r?\n/).filter(s=>s.length>0);
      if(!this.passwordOriginal&&operation==='save'&&values.length===0) throw new Error(this.texts.batchEmpty);
      return {operation:operation==='save'||operation==='global'?(this.passwordOriginal?'replace':'addMany'):operation,
        original:this.passwordOriginal,value:this.passwordValue,values:values,scopes:scopes};
    },
    passwordAction(operation,nextState) {
      if(this.saving||this.staging) return;
      if(operation==='save'&&!this.passwordDirty) { Object.assign(this,nextState||{passwordEditor:false}); return; }
      try { let edit=Object.assign(this.passwordEdit(operation),{nextState:nextState||{passwordEditor:false}}); this.staging=true; this.saveError=''; this.send('stagePassword',edit); }
      catch(e) { this.saveError=e.message; }
    },
    saveAll() {
      if(this.saving||this.staging||!this.changeCount) return;
      try {
        let drafts=Object.assign({},this.drafts,this.toggleDrafts);
        let fields=Object.keys(drafts).map(id=>{
          let f=this.fields.find(f=>f.id===id),d=drafts[id];
          if(!f) throw new Error(this.texts.configConflict);
          let text=f.editor==='lines'?JSON.stringify(d.text.split(/\r?\n/).filter(s=>s.length>0)):d.text;
          return {pointer:id,label:f.label,original:d.original,type:f.editor==='recursive'?'string':f.type,text:text,boolean:d.boolean,draft:Object.assign({},d)};
        });
        let password=this.passwordDirty?this.passwordEdit('save'):null,root=this.rootDirty?this.rootEdit('save'):null;
        this.saving=true; this.saveError='';
        this.send('saveAll',{fields:fields,passwordEdits:this.passwordEdits.slice(),rootEdits:this.rootEdits.slice(),passwordForm:password,rootForm:root});
      } catch(e) { this.saveError=e.message; }
    },
    discardAll() {
      if(this.saving||this.staging) return;
      this.drafts={}; this.toggleDrafts={}; this.passwordEdits=[]; this.rootEdits=[]; this.passwordEditor=false; this.rootEditor=false; this.passwordValue=''; this.passwordOriginal=''; this.scopeText=''; this.passwordBaseline=''; this.saveError=''; this.send('discard');
    }
  }
}
</script>
<style>
  .app { flex:1; gap:0px; color:var(--fg); font-size:14px; }
  .light { background:#f3f3f3; }
  .dark { background:#202020; }
  label { display:block; }
  .navigation { width:208px; flex-shrink:0; padding:24px 12px 8px; gap:4px; }
  .identity { flex-direction:row; align-items:center; gap:12px; padding:0px 12px 24px; }
  .app-icon { width:40px; height:40px; padding:9px; border-radius:8px; color:var(--accent-text); }
  .brand { font-size:20px; font-weight:600; }
  .nav-item { display:flex; width:100%; flex-direction:row; align-items:center; height:40px; padding:0px 4px; gap:12px; border:0px; border-radius:4px; background:#00000001; color:var(--fg); }
  .light .nav-item:hover { background:#ebebeb; }
  .dark .nav-item:hover { background:#2d2d2d; }
  .light .on { background:#e6e6e6; color:var(--fg); }
  .dark .on { background:#363636; color:var(--fg); }
  .nav-icon { width:18px; height:18px; color:var(--fg); }
  .nav-mark { width:3px; height:16px; }
  .nav-items { gap:4px; }
  .nav-indicator { position:absolute; left:4px; top:12px; width:3px; height:16px; border-radius:2px; background:var(--accent-text); }
  .light .nav-indicator { background:#0067c0; }
  .dark .nav-indicator { background:#60cdff; }
  .spacer { flex:1; }
  .body { flex:1; flex-direction:row; }
  .sidebar { flex:1; padding:20px 8px 0px; gap:8px; }
  .sidebar-heading { font-size:12px; color:var(--fg-2); padding:0px 4px 4px; }
  .sidebar button { min-height:32px; }
  .context-item { display:flex; width:100%; flex-direction:row; align-items:center; padding:7px 12px; gap:10px; border:0px; background:#00000001; color:var(--fg); }
  .context-item:hover { background:var(--sidebar-hover); }
  .content { flex:1; padding:24px 28px 24px; gap:16px; }
  .workspace { flex:1; gap:12px; }
  .page-header { flex-direction:row; flex-wrap:wrap; align-items:center; gap:12px; padding-bottom:4px; }
  .row { flex-direction:row; align-items:center; gap:8px; }
  .column { gap:8px; }
  .fill { flex:1; }
  .heading { font-size:28px; font-weight:600; }
  .subheading { font-size:14px; font-weight:600; }
  .muted { color:var(--fg-2); font-size:12px; }
  .small { font-size:12px; }
  .directory-pane { width:224px; flex-shrink:0; padding:24px 10px 24px 0px; gap:10px; }
  .directory-pane > input, .directory-pane > button { width:100%; flex-shrink:0; }
  .directory-list { gap:2px; }
  .directory-list > button { width:100%; flex-shrink:0; }
  .directory-item { min-height:50px; padding:6px 8px; flex-shrink:0; }
  .directory-item .column { gap:2px; }
  .directory-name, .directory-path { white-space:nowrap; }
  .directory-actions button { flex:1; flex-shrink:0; }
  .selected-directory { gap:3px; }
  .selected-directory label { font-size:12px; color:var(--fg-2); }
  .task-filters { flex-wrap:wrap; }
  .task-filters input { min-width:180px; }
  .card { padding:16px 20px; gap:10px; border:1px solid var(--card-border); border-radius:8px; }
  .settings-row { flex-direction:row; align-items:center; gap:16px; }
  .setting-copy { flex:1; gap:4px; }
  .setting-title { font-size:14px; }
  .task { padding:16px; gap:8px; border:1px solid var(--card-border); border-radius:8px; cursor:pointer; }
  .taskname { display:flex; flex:1; flex-shrink:1; flex-direction:row; align-items:center; background:#00000001; padding:0px; border:0px; color:var(--fg); }
  .status { font-size:14px; font-weight:600; padding:4px 10px; border-radius:4px; flex-shrink:0; white-space:nowrap; }
  .light .status-success { color:#0f6b35; background:#dff6dd; }
  .dark .status-success { color:#6ccb5f; background:#263c28; }
  .light .status-waiting { color:#7a4e00; background:#fff4ce; }
  .dark .status-waiting { color:#fce100; background:#433d24; }
  .light .status-failure { color:#a4262c; background:#fde7e9; }
  .dark .status-failure { color:#ff99a4; background:#442726; }
  .light .status-info { color:#005a9e; background:#e5f1fb; }
  .dark .status-info { color:#75b6e7; background:#243b50; }
  .time { color:var(--fg-2); font-size:12px; }
  .error { color:#d15b48; font-size:12px; }
  .light .card, .task.light, .card.light { background:#fbfbfb; border:1px solid #e5e5e5; }
  .dark .card, .task.dark, .card.dark { background:#2b2b2b; border:1px solid #303030; }
  .pager { flex-direction:row; align-items:center; gap:12px; }
  .pager label { font-size:12px; color:var(--fg-2); }
  /* Actions keep their intrinsic text width even when a scrollbar appears.
     Flexible text/inputs yield space; action rows wrap instead of shrinking. */
  button { padding:6px 12px; border-radius:4px; min-height:32px; flex-shrink:0; cursor:pointer; }
  toggle { flex-shrink:0; }
  .action-row { flex-direction:row; flex-wrap:wrap; align-items:center; gap:8px; }
  .input-row { flex-direction:row; flex-wrap:wrap; align-items:center; gap:8px; }
  .input-row input { min-width:140px; }
  .inline-form { flex-shrink:0; }
  .composer-fields { flex-direction:row; flex-wrap:wrap; gap:16px; }
  .composer-field { width:46%; min-width:180px; gap:6px; }
  .scope-value { white-space:pre-wrap; }
  .password-tabs { flex-direction:row; flex-wrap:wrap; align-items:center; gap:8px; }
  .password-tabs input { flex:1; min-width:180px; }
  input, select { height:32px; }
  .content > input, .sidebar > input, .inline-form textarea { display:block; width:100%; }
  textarea { min-height:90px; }
  /* Core UI scrollbars overlay the viewport (up to 9 px plus a 2 px
     inset). Reserve 18 px for the bar and shadows in every scroll pane. */
  ScrollView { flex:1; padding:2px 18px 6px 2px; }
  .setting-control { width:220px; gap:8px; }
  .setting-control input, .setting-control textarea { width:100%; }
  .toggle-host { height:26px; align-items:flex-end; }
  .setting-card { padding:16px 20px; gap:10px; border:1px solid var(--card-border); border-radius:8px; }
  .setting-card.light { background:#fbfbfb; border:1px solid #e5e5e5; }
  .setting-card.dark { background:#2b2b2b; border:1px solid #303030; }
  .setting-card { gap:0px; padding:0px 20px; }
  .block-fields { gap:0px; }
  .setting-item { padding:16px 0px; gap:10px; }
  .setting-item > textarea { width:100%; }
  .setting-divider { height:1px; background:var(--card-border); }
  .block-heading { padding:16px 0px 0px; font-size:14px; font-weight:600; }
  .runtime-badge { flex-direction:row; align-items:center; gap:7px; }
  .runtime-dot { width:8px; height:8px; border-radius:4px; background:#8a8a8a; }
  .runtime-dot.running { background:#6ccb5f; }
  .setting-description { color:var(--fg-2); font-size:12px; }
  .choice-host { height:32px; flex-direction:row; }
  .password-input { height:90px; }
  .history-list { gap:0px; border:1px solid var(--card-border); border-radius:8px; padding:0px 12px; }
  .history-list.light { background:#fbfbfb; }
  .history-list.dark { background:#2b2b2b; }
  .history-entry { gap:0px; }
  .scope-value { padding:2px 0px 0px; }
  .history-row { flex-direction:row; align-items:center; gap:12px; padding:4px 0px; min-height:40px; }
  .password-row { padding:12px 0px; }
  .password-copy { flex:1; gap:0px; }
  .history-copy { width:132px; }
  .history-divider { height:1px; background:var(--card-border); }
  .nav-item { transition:background-color 140ms ease-out; }
  .save-panel { padding:12px 4px 4px; gap:8px; }
  .save-panel button { width:100%; flex-shrink:0; }
</style>
<template>
  <div :class="'app '+appearance">
    <div class="body">
      <div class="navigation">
        <div class="identity">
          <svg class="app-icon" viewBox="0 0 24 24" fill="none"><path d="M3 7 12 3 21 7 12 11 3 7ZM3 7v10l9 4 9-4V7M12 11v10M7.5 5 16.5 9" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          <div class="column" style="gap:3px"><label class="brand">SunPack</label><label class="muted">{{ texts.manager }}</label></div>
        </div>
      <div class="nav-items">
        <button id="tabTasks" :class="tab==='tasks'?'nav-item on':'nav-item'" @click="go('tasks')">
          <div class="nav-mark"/>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none"><path d="m3 6 1.5 1.5L7 5M10 6h11M3 12l1.5 1.5L7 11M10 12h11M3 18l1.5 1.5L7 17M10 18h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><label>{{ texts.tasks }}</label>
        </button>
        <button id="tabConfig" :class="tab==='config'?'nav-item on':'nav-item'" @click="go('config')">
          <div class="nav-mark"/>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 17h16M8 4v6M16 14v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><label>{{ texts.config }}</label>
        </button>
        <button id="tabPasswords" :class="tab==='passwords'?'nav-item on':'nav-item'" @click="go('passwords')">
          <div class="nav-mark"/>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none"><path d="M14 5a5 5 0 1 1-2 8l-7 7H2v-3l7-7a5 5 0 0 1 5-5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><label>{{ texts.passwords }}</label>
        </button>
        <div id="navIndicator" class="nav-indicator"/>
      </div>
      <div v-show="tab==='config'" class="sidebar">
        <label class="sidebar-heading">{{ texts.categories }}</label>
        <button :class="!configCategory?'context-item on':'context-item'" @click="selectCategory('')"><label>{{ texts.allSettings }}</label></button>
        <ScrollView id="categoryScroll"><div class="column"><button v-for="c in categories" :key="c.id" :id="'category-'+c.id" :class="configCategory===c.id?'context-item on':'context-item'" @click="selectCategory(c.id)"><label>{{ c.label }}</label></button></div></ScrollView>
      </div>
      <div v-show="tab!=='config'" class="spacer"/>
      <div class="save-panel">
        <label class="muted">{{ saving?texts.saving:changeCount?changeCount+' '+texts.pendingChanges:texts.noChanges }}</label>
        <label v-show="saveError" class="error">{{ saveError }}</label>
        <button id="discardAll" :enabled="changeCount>0 &amp;&amp; !saving &amp;&amp; !staging" @click="discardAll()">{{ texts.discardChanges }}</button>
        <button id="saveAll" type="primary" :enabled="ready &amp;&amp; changeCount>0 &amp;&amp; !saving &amp;&amp; !staging" @click="saveAll()">{{ texts.saveChanges }}</button>
      </div>
      </div>
      <div id="directoryPane" v-show="tab==='tasks'" class="directory-pane">
        <div class="row"><label class="subheading fill">{{ texts.roots }}</label><label class="muted">{{ directoryCount }}</label></div>
        <button id="newRoot" @click="editRoot(null)">{{ texts.addRoot }}</button>
        <label class="muted">{{ texts.searchDirectory }}</label><input id="directorySearch" :value="directoryQuery" @input="searchDirectory"/>
        <button id="allRoots" :class="!taskRoot?'context-item on':'context-item'" @click="selectRoot('')"><label>{{ texts.allDirectories }}</label></button>
        <ScrollView id="directoryListScroll"><div class="directory-list">
          <button v-for="d in shownDirectories" :key="d.id" :id="'directory-'+d.id" class="context-item directory-item" :class="taskRoot===d.path?'on':''" @click="selectRoot(d.path)">
            <div class="column fill"><label class="directory-name">{{ d.name||d.path }}</label><label class="muted directory-path">{{ d.path }}</label></div>
          </button>
          <button id="moreDirectories" v-show="directoryLimit &lt; directoryCount" @click="directoryLimit=directoryLimit+50">{{ texts.moreDirectories }}</button>
        </div></ScrollView>
        <div v-show="tab==='tasks' &amp;&amp; chosenDirectory.path" class="row directory-actions"><button id="editSelectedRoot" @click="editRoot(chosenDirectory)">{{ texts.edit }}</button><button @click="send('openPath',{path:chosenDirectory.path})">{{ texts.open }}</button></div>
      </div>
      <div class="workspace">
      <div id="page-tasks" v-show="tab==='tasks'" class="content">
        <div class="page-header"><label class="heading">{{ texts.tasks }}</label><div class="spacer"/><div id="runtimeStatus" class="runtime-badge"><div :class="runtime.known &amp;&amp; runtime.running?'runtime-dot running':'runtime-dot'"/><label class="muted">{{ !runtime.known?texts.runtimeUnknown:runtime.running?texts.runtimeRunning:texts.runtimeStopped }}</label></div></div>
        <div class="row"><button id="watchStart" :enabled="cliAllowed" @click="send('cli',{action:'start'})">{{ texts.startWatch }}</button><button id="watchStop" :enabled="cliAllowed" @click="send('cli',{action:'stop'})">{{ texts.stopWatch }}</button></div>
        <label v-show="actionError" class="error">{{ actionError }}</label>
        <div v-show="chosenDirectory.path &amp;&amp; !rootEditor" class="selected-directory"><label>{{ chosenDirectory.path }}</label><label>{{ texts.output }}{{ chosenDirectory.effectiveOutput }}</label></div>
        <div v-show="!rootEditor" class="column"><label class="muted">{{ texts.taskSearch }}</label><div class="row task-filters"><input id="taskSearch" class="fill" :value="taskQuery" @input="searchTasks"/>
          <div id="taskStatusHost" style="width:180px;height:32px"/>
        </div></div>
        <ScrollView id="taskListScroll"><div id="taskBody" class="column">
        <div id="rootForm" v-show="rootEditor" class="card inline-form" :enabled="!saving &amp;&amp; !staging">
          <div class="row"><label class="subheading">{{ rootOriginal?texts.editRoot:texts.addRoot }}</label><div class="spacer"/><button id="closeRootEditor" @click="rootAction('save')">{{ texts.back }}</button></div>
          <label class="muted">{{ rootOriginal?texts.inputDirectory:texts.rootBatchHint }}</label><textarea id="rootInput" v-model="rootInput" style="height:84px"/><button id="browseRoot" @click="send('browse',{target:'rootInput'})">{{ texts.chooseDirectory }}</button>
          <label class="muted">{{ texts.rootOutput }}</label><div class="input-row"><input id="rootOutput" class="fill" v-model="rootOutput"/><button id="browseOutput" @click="send('browse',{target:'rootOutput'})">{{ texts.chooseOutput }}</button></div>
          <div class="action-row"><toggle id="rootDeepToggle" v-model="rootDeep"/><label>{{ texts.deep }}</label><button id="finishRoot" @click="rootAction('save')">{{ rootOriginal?texts.finishEditing:texts.addToList }}</button><button v-show="rootOriginal" @click="rootAction('delete')">{{ texts.deleteRoot }}</button></div>
        </div>
          <label v-show="tasks.total===0" class="muted">{{ texts.noTasks }}</label>
          <div v-for="t in tasks.rows" :key="t.id" :id="'task-'+t.id" :class="'task '+appearance" @click="send('openTask',{id:t.id})">
            <div class="row"><button :id="'taskName-'+t.id" class="taskname" @click="send('openTask',{id:t.id})"><label class="fill subheading">{{ t.name }}</label></button><label class="status" :class="'status-'+t.statusTone">{{ t.statusText }}</label></div>
            <label class="muted">{{ t.path }}</label><div class="row"><div class="spacer"/><label class="time">{{ t.time }}</label></div>
          </div>
        </div></ScrollView>
        <div v-show="!rootEditor" class="pager"><button :enabled="tasks.page>0" @click="filterTasks(tasks.page-1)">{{ texts.previous }}</button><label>{{ tasks.page+1 }} / {{ tasks.pages }} · {{ tasks.total }} {{ texts.taskCount }}</label><button :enabled="tasks.page+1 &lt; tasks.pages" @click="filterTasks(tasks.page+1)">{{ texts.next }}</button></div>
        <label v-show="tasks.malformed" class="error">{{ tasks.malformed }} {{ texts.invalidLogs }}</label>
      </div>
      <div id="page-config" v-show="tab==='config'" class="content">
        <div class="page-header"><label class="heading">{{ texts.config }}</label></div>
        <label v-show="actionError" class="error">{{ actionError }}</label>
        <label class="muted">{{ texts.settingSearch }}</label><input id="configSearch" :value="configQuery" @input="searchConfig"/>
        <ScrollView id="configListScroll"><div id="configBlocks" class="column">
          <div v-show="!configCategory &amp;&amp; !configQuery &amp;&amp; configPage===0" class="card settings-row">
            <div class="setting-copy"><label class="setting-title">{{ texts.startup }}</label><label class="muted">{{ texts.startupDescription }}</label></div>
            <button id="startupToggle" :enabled="cliAllowed" @click="send('cli',{action:startup.enabled?'startupDisable':'startupEnable'})">{{ startup.enabled?texts.startupOff:texts.startupOn }}</button>
          </div>
          <div v-show="!configCategory &amp;&amp; !configQuery &amp;&amp; configPage===0" class="card settings-row"><div class="setting-copy"><label class="setting-title">{{ texts.theme }}</label><label class="muted">{{ texts.themeDescription }}</label></div><div id="themeHost" style="width:180px;height:32px"/></div>
          <div v-for="g in shownBlocks" :key="g.key" :id="'block-'+g.id" :class="'setting-card '+appearance">
            <label v-show="(g.fields.length>1||g.module) &amp;&amp; !g.primary" class="block-heading">{{ g.label }}</label>
            <!-- This Core UI version binds inner loops through a conditional
                 scope. Groups are always nonempty; visibility uses v-show. -->
            <div v-if="true" class="block-fields">
            <div v-for="f in g.fields" :key="f.key" :id="'field-'+f.id" class="setting-item">
            <div v-show="f.id!==g.fields[0].id" class="setting-divider"/>
            <div class="settings-row">
              <div class="setting-copy"><label :class="f.primary?'subheading':'setting-title'">{{ f.label }}</label><label v-show="f.description" class="setting-description">{{ f.description }}</label></div>
              <div class="setting-control">
                <div v-show="f.editor==='toggle'" :id="'toggle-host-'+f.id" :enabled="!saving" class="toggle-host"/>
                <div v-show="f.editor==='choice'||f.editor==='recursive'" :id="'choice-'+f.id" class="choice-host"/>
                <input v-show="f.editor==='text'" :id="'input-'+f.id" :value="drafts[f.id]?drafts[f.id].text:f.text" @input="v=>changeField(f,v)"/>
                <div v-show="f.editor==='recursive' &amp;&amp; (drafts[f.id]?drafts[f.id].choice:f.choice)===2" class="column"><label class="muted">{{ texts.rounds }}</label><input :id="'rounds-'+f.id" :value="drafts[f.id]?drafts[f.id].text:f.text" @input="v=>changeField(f,v)"/></div>
                <label v-show="f.editor==='readonly'" class="muted">{{ texts.readOnly }}</label>
              </div>
            </div>
            <textarea v-show="f.editor==='lines'" :id="'lines-'+f.id" :value="drafts[f.id]?drafts[f.id].text:f.text" @input="v=>changeField(f,v)" style="height:110px"/>
            </div>
            </div>
          </div>
          <label v-show="matchingBlocks.length===0" class="muted">{{ texts.noSettings }}</label>
        </div></ScrollView>
        <div v-show="configPages>1" class="pager"><button :enabled="configPage>0" @click="configPage=configPage-1">{{ texts.previous }}</button><label>{{ configPage+1 }} / {{ configPages }}</label><button :enabled="configPage+1 &lt; configPages" @click="configPage=configPage+1">{{ texts.next }}</button></div>
      </div>
      <div id="page-passwords" v-show="tab==='passwords'" class="content">
        <div class="page-header"><label class="heading">{{ texts.passwords }}</label></div>
        <label v-show="actionError" class="error">{{ actionError }}</label>
        <div class="password-tabs"><button id="newPassword" :class="passwordEditor &amp;&amp; !passwordOriginal?'on':''" @click="editPassword(null)">{{ texts.addPasswords }}</button><button id="savedPasswords" :class="passwordScope==='@all' &amp;&amp; !passwordEditor?'on':''" @click="selectScope('@all')">{{ texts.savedPasswords }}</button><button id="clipboardHistory" :class="passwordScope==='@history' &amp;&amp; !passwordEditor?'on':''" @click="selectScope('@history')">{{ texts.history }}</button><label class="muted">{{ texts.passwordSearch }}</label><input id="passwordSearch" :value="passwordQuery" @input="searchPasswords"/></div>
        <ScrollView id="passwordListScroll"><div id="passwordBody" class="column">
          <div id="passwordForm" v-show="passwordEditor" class="card inline-form" :enabled="!saving &amp;&amp; !staging">
            <div class="row"><label class="subheading">{{ passwordOriginal?texts.editPassword:texts.addPasswords }}</label><div class="spacer"/><button id="closePasswordEditor" @click="passwordAction('save')">{{ texts.back }}</button></div>
              <div class="composer-fields"><div class="composer-field"><label class="subheading">{{ texts.passwordText }}</label><label v-show="!passwordOriginal" class="muted">{{ texts.batchHint }}</label><textarea id="passwordValue" v-model="passwordValue" class="password-input"/></div>
              <div class="composer-field"><label class="subheading">{{ texts.scopeLabel }}</label><label class="muted">{{ texts.scopeDescription }}</label><textarea id="passwordScopes" v-model="scopeText" class="password-input"/></div></div>
              <div class="action-row"><button id="browseScope" @click="send('browse',{target:'scopeText'})">{{ texts.chooseScope }}</button><button v-show="passwordOriginal &amp;&amp; scopeText" @click="passwordAction('global')">{{ texts.makeGlobal }}</button><button id="finishPassword" @click="passwordAction('save')">{{ passwordOriginal?texts.finishEditing:texts.addToList }}</button><button v-show="passwordOriginal" @click="passwordAction('delete')">{{ texts.deletePassword }}</button></div>
          </div>
          <div :class="'history-list '+appearance"><label v-show="passwords.total===0" class="muted">{{ texts.noPasswords }}</label>
            <div v-for="p in passwords.rows" :key="p.id" :id="'password-'+p.id" class="history-entry">
              <div class="row history-row" :class="'row history-row '+(passwordScope==='@all'?'password-row':'')"><div class="password-copy"><label>{{ p.value }}</label><label v-show="passwordScope==='@all'" class="muted scope-value">{{ texts.scopeLabel }} · {{ p.scopes||texts.allFolders }}</label></div><button v-show="passwordScope==='@history'" class="history-copy" :id="'copy-history-'+p.id" @click="editPassword(p)">{{ texts.copyPassword }}</button><button v-show="passwordScope==='@all'" :id="'edit-password-'+p.id" @click="editPassword(p)">{{ texts.edit }}</button></div>
              <div class="history-divider"/>
            </div>
          </div>
        </div></ScrollView>
        <div class="pager"><button :enabled="passwords.page>0" @click="filterPasswords(passwords.page-1)">{{ texts.previous }}</button><label>{{ passwords.page+1 }} / {{ passwords.pages }} · {{ passwords.total }} {{ texts.entries }}</label><button :enabled="passwords.page+1 &lt; passwords.pages" @click="filterPasswords(passwords.page+1)">{{ texts.next }}</button></div>
      </div>
      </div>
    </div>
    <div v-show="errorList.length" class="card"><label class="error">{{ texts.fileProblems }}</label><label v-for="e in errorList" :key="e" class="error">{{ e }}</label></div>
    <div v-if="dispatch" id="dispatch" :visible="false" style="position:absolute;left:0px;top:0px;width:0px;height:0px"/>
  </div>
</template>
